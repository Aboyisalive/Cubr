{
  "name": "@cubr/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Generated TypeScript client for the cubr API. Do not edit src/ by hand; run `just codegen` from the repo root.",
  "type": "module",
  "scripts": {
    "generate": "openapi-ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@hey-api/client-fetch": "^0.13.0"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.88.0",
    "eslint": "^9.39.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  }
}
